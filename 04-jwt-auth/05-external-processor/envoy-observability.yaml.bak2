static_resources:
  listeners:
    - name: listener_0
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8084
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress_http
                codec_type: AUTO
                generate_request_id: true
                tracing:
                  provider:
                    name: envoy.tracers.opentelemetry
                    typed_config:
                      "@type": type.googleapis.com/envoy.config.trace.v3.OpenTelemetryConfig
                      grpc_service:
                        envoy_grpc:
                          cluster_name: phoenix
                        timeout: 0.5s
                      service_name: envoy-llm-gateway
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: local_service
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/v1/chat/completions"
                          route:
                            cluster_header: x-target-cluster
                            timeout: 120s
                http_filters:
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      inline_code: |
                        function envoy_on_request(request_handle)
                          local trace_id = request_handle:headers():get("x-trace-id")
                          if not trace_id or trace_id == "" then
                            trace_id = string.format("%016x%016x", math.random(0, 18446744073709551615), math.random(0, 18446744073709551615))
                            request_handle:headers():add("x-trace-id", trace_id)
                          end
                          
                          local body = request_handle:body()
                          local body_str = ""
                          if body then
                            body_str = body:getBytes(0, body:length())
                          end
                          
                          local intent = "general"
                          local content = body_str:match('"content":"([^"]+)"')
                          
                          if content then
                            content = string.lower(content)
                            if content:match("def") or content:match("class") or content:match("import") or content:match("function") or content:match("python") or content:match("code") then
                              intent = "code"
                            elseif content:match("analyze") or content:match("compare") or content:match("explain") then
                              intent = "analysis"
                            elseif content:match("story") or content:match("poem") or content:match("creative") or content:match("write") then
                              intent = "creative"
                            end
                          end
                          
                          local hint = request_handle:headers():get("x-intent")
                          if hint and hint ~= "" then
                            intent = string.lower(hint)
                          end
                          
                          local cluster_map = {
                            code = "code_model",
                            analysis = "analysis_model",
                            creative = "creative_model",
                            general = "general_model"
                          }
                          
                          local cluster = cluster_map[intent] or "general_model"
                          
                          request_handle:headers():add("x-intent-detected", intent)
                          request_handle:headers():add("x-target-cluster", cluster)
                          request_handle:headers():add("x-routed-by", "envoy-lua-mlops")
                        end

                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: code_model
      connect_timeout: 5s
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      lb_policy: ROUND_ROBIN
      health_checks:
        - timeout: 5s
          interval: 10s
          unhealthy_threshold: 2
          healthy_threshold: 1
          http_health_check:
            path: "/api/tags"
      load_assignment:
        cluster_name: code_model
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ollama-local
                      port_value: 11434

    - name: analysis_model
      connect_timeout: 5s
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      lb_policy: ROUND_ROBIN
      health_checks:
        - timeout: 5s
          interval: 10s
          unhealthy_threshold: 2
          healthy_threshold: 1
          http_health_check:
            path: "/api/tags"
      load_assignment:
        cluster_name: analysis_model
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ollama-local
                      port_value: 11434

    - name: creative_model
      connect_timeout: 5s
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      lb_policy: ROUND_ROBIN
      health_checks:
        - timeout: 5s
          interval: 10s
          unhealthy_threshold: 2
          healthy_threshold: 1
          http_health_check:
            path: "/api/tags"
      load_assignment:
        cluster_name: creative_model
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ollama-local
                      port_value: 11434

    - name: general_model
      connect_timeout: 5s
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      lb_policy: ROUND_ROBIN
      health_checks:
        - timeout: 5s
          interval: 10s
          unhealthy_threshold: 2
          healthy_threshold: 1
          http_health_check:
            path: "/api/tags"
      load_assignment:
        cluster_name: general_model
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ollama-local
                      port_value: 11434

    - name: phoenix
      connect_timeout: 1s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          upstream_protocol_options:
            explicit_http_config:
              http2_protocol_options: {}
      load_assignment:
        cluster_name: phoenix
        endpoints:
        - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: phoenix-mlops
                      port_value: 4317

admin:
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 9901
    access_log:
      - name: envoy.access_loggers.stdout
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
